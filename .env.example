# 复制此文件为 .env，再填写密钥。不要上传或截图展示 .env。
# 本文件只是模板，程序实际读取 .env；# 开头为注释，KEY=VALUE 为配置。
# 系统中已设置的同名环境变量优先，修改 .env 后刷新网页重新读取。
# DeepSeek V4 Pro；若使用其他服务商，请同时更改接口地址和模型名。
# 模型密钥：等号后在本机填写服务商提供的值，不要把值发送到聊天中。
DEEPSEEK_API_KEY=
# 接口根地址，必须 HTTPS；地址必须与上面的密钥属于同一家服务。
LLM_BASE_URL=https://api.deepseek.com
# API 要求的准确模型 ID，不是随意填写的产品宣传名称。
LLM_MODEL=deepseek-v4-pro
# 单次模型请求等待上限（秒），填整数；程序会限制在 10～180 之间。
LLM_TIMEOUT=90

# 若留空，官方 ima 脚本还会读取本机 ~/.config/ima/ 中的凭证文件。
# ima 的 Client ID 和 API Key 成对配置，与上面的模型密钥不同。
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
# 已加入的共享知识库完整名称，用于精确匹配；不是本机文件夹路径。
IMA_KB_NAME=任德耀新建华为PC知识库copy

# 通常不需要更改。路径相对于本项目目录。
# 指向官方 JavaScript 入口，Python 会通过 Node.js 调用它。
IMA_SKILL_PATH=vendor/ima-skill/ima_api.cjs
